# You design and build LEGO Technic models one step at a time, in a build language.
# 
# For each step you write:
# ADD name partnumber color
# CONNECT part.point -> part.point LOCKED|TURNS|STIFF   (points: hole1.., axlehole1.., pin1.., axle1.., clip1..; LOCKED = cross in cross, turn together; TURNS = free; STIFF = friction pin)
# Optional: MESH a.teeth b.teeth / RATIO a b x/y / GROUP g (opens a side build) / END (closes it) / ATTACH g (joins a finished side build into the main model)
# WHY one plain sentence: what this step builds and what it is for.
# A point ending in ~ is an estimate; ? means not known.
# 
STEP 1
ADD k-tri-1 99773 lightgray
ADD k-pin-1 61332 black
ADD k-pin-2 61332 black
CONNECT k-pin-1.pin1 -> k-tri-1.hole3~ STIFF
CONNECT k-pin-2.pin1 -> k-tri-1.hole5~ STIFF
WHY Starts the steering knuckle with a triangle beam and two pins that stick out the back for the next beam.
STEP 2
ADD k-tri-2 99773 lightgray
CONNECT k-pin-1.pin2 -> k-tri-2.hole3~ STIFF
CONNECT k-pin-2.pin2 -> k-tri-2.hole5~ STIFF
WHY Puts a second triangle on the pins so the two triangles form a rigid pair.
STEP 3
ADD k-conn-1 42135 darkgray
ADD k-axle-1 32073 yellow
CONNECT k-conn-1.axlehole1 -> k-tri-2.hole1~ LOCKED
CONNECT k-axle-1.axle1 -> k-conn-1.axlehole2~ LOCKED
WHY Adds a yellow 5-long axle locked in a connector at one corner as the pivot for the wheel hub.
STEP 4
ADD k-bush-1 3713 red
ADD k-hub-1 27940 darkgray
ADD k-hub-2 44874 black
CONNECT k-bush-1.axlehole1 -> k-axle-1.axle2~ LOCKED
CONNECT k-hub-1.hole1~ -> k-tri-2.hole2~ TURNS
CONNECT k-hub-2.pin1~ -> k-tri-2.hole4~ STIFF
WHY A red bush holds the axle on and two hub pieces start the joints at the other corners.
STEP 5
ADD k-tri-3 99773 lightgray
ADD k-tri-4 99773 lightgray
CONNECT k-pin-1.pin1 -> k-tri-3.hole3~ STIFF
CONNECT k-pin-2.pin1 -> k-tri-4.hole5~ STIFF
WHY Closes the knuckle on the other side with two more triangles so it becomes a box.
STEP 6
ADD k-conn-2 42135 darkgray
ADD k-pin-3 61332 black
ADD k-pin-4 61332 black
CONNECT k-pin-3.pin1 -> k-tri-3.hole1~ STIFF
CONNECT k-pin-4.pin1 -> k-tri-4.hole1~ STIFF
CONNECT k-conn-2.axlehole1~ -> k-pin-3.pin2 TURNS
WHY Adds a connector and two pins on the inside to tie the triangle pairs together.
STEP 7
ADD k-apin-1 18651 black
ADD k-apin-2 18651 black
CONNECT k-apin-1.pin1 -> k-tri-3.hole2~ STIFF
CONNECT k-apin-2.pin1 -> k-tri-4.hole2~ STIFF
WHY Adds two axle pins on the back that carry the next connectors.
STEP 8
ADD k-conn-3 42135 darkgray
ADD k-conn-4 42135 darkgray
ADD k-lpin-1 11214 red
ADD k-lpin-2 11214 red
CONNECT k-conn-3.axlehole1~ -> k-apin-1.axle1 LOCKED
CONNECT k-conn-4.axlehole1~ -> k-apin-2.axle1 LOCKED
CONNECT k-lpin-1.axle1 -> k-conn-3.axlehole2~ LOCKED
CONNECT k-lpin-2.axle1 -> k-conn-4.axlehole2~ LOCKED
WHY Adds two connectors and red axle pins that stick out the sides as the stub axles the wheel will sit on.
STEP 9
ADD m-motor-1 22169 lightgray
CONNECT m-motor-1.hole1? -> k-tri-3.hole1~ STIFF
WHY Fits the first large motor against the knuckle: this one will drive the front axle.
STEP 10
ADD m-motor-2 22169 lightgray
CONNECT m-motor-2.hole1? -> k-tri-4.hole1~ STIFF
WHY Fits the second large motor beside the first so the two sit side by side.
STEP 11
ADD m-pin-1 61332 black
