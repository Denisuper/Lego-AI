ADD beam5-s 32316 lightgray
ADD pin-s2 6558 blue
# settled with step 4: the 3-long pins go through beam5-s, back end into lbeam-s1, front end later takes lbeam-s2
CONNECT pin-s2.pin2 -> beam5-s.hole2 STIFF
CONNECT pin-s2.pin1 -> lbeam-s1.hole2 STIFF
ADD pin-s3 6558 blue
CONNECT pin-s3.pin2 -> beam5-s.hole4 STIFF
CONNECT pin-s3.pin1 -> lbeam-s1.hole4 STIFF
DOES beam5-s HOLDS pin-s2
DOES beam5-s HOLDS pin-s3
DOES pin-s2 LOCKS beam5-s
DOES pin-s3 LOCKS beam5-s
PATTERN doubled_upright
