STEP 32
# Which shaft gets bush-32 is read from the arrow only.
ADD ycon-1 6536 yellow
ADD ycon-2 6536 yellow
ADD bush-32 3713 lightgray
CONNECT ycon-1.hole1 -> pin-b2.pin3 STIFF
CONNECT ycon-2.hole1 -> pin-b1.pin3 STIFF
CONNECT bush-32.axlehole1 -> axle8s-1.axle1 LOCKED
DOES pin-b2 HOLDS ycon-1
DOES pin-b1 HOLDS ycon-2
DOES bush-32 LOCKS axle8s-1
PATTERN pin_to_axlehole_adapter
