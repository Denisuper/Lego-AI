ADD lthin-1 32056 yellow
ADD axle2-b1 32062 red
ADD axle2-b2 32062 red
ADD axle2-b3 32062 red
CONNECT axle2-b1.axle1 -> lthin-1.hole1 TURNS
CONNECT axle2-b2.axle1 -> lthin-1.axlehole2~ LOCKED
CONNECT axle2-b3.axle1 -> lthin-1.axlehole3~ LOCKED
DOES lthin-1 HOLDS axle2-b1
DOES lthin-1 HOLDS axle2-b2
DOES lthin-1 HOLDS axle2-b3
PATTERN stacked_beams_on_short_axles
