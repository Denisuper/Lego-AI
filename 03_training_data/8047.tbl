PATTERN doubled_side_beam

STEP 38
# Joins read from the two arrows only.
GROUP arm
ADD beam3t-a1 6632 yellow
ADD axle3-a1 4519 lightgray
CONNECT axle3-a1.end1 -> beam3t-a1.hole1
DOES beam3t-a1 HOLDS axle3-a1
PATTERN axle_as_post
ADD curve-a1 32250 yellow
CONNECT axle3-a1.mid -> curve-a1.hole1
DOES axle3-a1 HOLDS curve-a1
PATTERN curved_side_plate
# No arrows; places read from the picture.
ADD pin34-a 32002 darkgray
ADD conn3c-a1 32184 lightgray
CONNECT pin34-a.end1 -> curve-a1.hole?
CONNECT conn3c-a1.pinhole -> pin34-a.end2
CONNECT conn3c-a1.axlehole1 -> axle3-a1.end2
