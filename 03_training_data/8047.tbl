ADD tread-56 3873 black
CONNECT tread-29.end2 -> tread-30.end1
CONNECT tread-30.end2 -> tread-31.end1
CONNECT tread-31.end2 -> tread-32.end1
CONNECT tread-32.end2 -> tread-33.end1
CONNECT tread-33.end2 -> tread-34.end1
CONNECT tread-34.end2 -> tread-35.end1
CONNECT tread-35.end2 -> tread-36.end1
CONNECT tread-36.end2 -> tread-37.end1
CONNECT tread-37.end2 -> tread-38.end1
