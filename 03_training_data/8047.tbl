CONNECT tread-56.end2 -> tread-29.end1
END
ATTACH track-right
MESH tread-?.teeth gear-3.teeth
MESH tread-?.teeth gear-4.teeth
DOES gear-1 HOLDS track-left
DOES gear-2 HOLDS track-left
DOES gear-3 HOLDS track-right
DOES gear-4 HOLDS track-right
DOES beam9-X SUPPORTS track-left
DOES beam9-Y SUPPORTS track-right
PATTERN track_loop_on_idlers

STEP 16
# model flipped: turntable-O's toothed half now on top
ADD pinlong-1 6558 blue
CONNECT pinlong-1.end1 -> turntable-O.top.hole?
ADD pinlong-2 6558 blue
CONNECT pinlong-2.end1 -> turntable-O.top.hole?
DOES turntable-O HOLDS pinlong-1
DOES turntable-O HOLDS pinlong-2
PATTERN pins_as_mounting_posts

STEP 17
GROUP seat
# seat side build, steps 1-11 (pages 8-11)
ADD hub4-s 48989 lightgray
ADD pin-s1 6558 blue
CONNECT pin-s1.end1 -> hub4-s.hole?
ADD hub2-s 87082 lightgray
CONNECT hub2-s.hole1 -> hub4-s.pin?
DOES hub4-s HOLDS pin-s1
DOES hub4-s HOLDS hub2-s
PATTERN pin_hub_core
ADD lbeam-s1 32526 blue
CONNECT lbeam-s1.hole? -> hub4-s.pin?
DOES hub4-s HOLDS lbeam-s1
PATTERN l_beam_as_seat
ADD beam5-s 32316 lightgray
ADD pin-s2 6558 blue
CONNECT pin-s2.end1 -> beam5-s.hole2
ADD pin-s3 6558 blue
CONNECT pin-s3.end1 -> beam5-s.hole4
CONNECT beam5-s.hole? -> lbeam-s1.hole?
DOES beam5-s HOLDS pin-s2
DOES beam5-s HOLDS pin-s3
DOES lbeam-s1 SUPPORTS beam5-s
PATTERN doubled_upright
ADD lbeam-s2 32526 blue
CONNECT pin-s2.end2 -> lbeam-s2.hole?
CONNECT pin-s3.end2 -> lbeam-s2.hole?
DOES pin-s2 LOCKS lbeam-s2
DOES pin-s3 LOCKS lbeam-s2
PATTERN mirror_side
ADD block-s 60483 lightgray
CONNECT block-s.pinhole -> hub4-s.pin?
ADD conn-s1 42003 black
CONNECT conn-s1.pinhole? -> hub4-s.pin?
DOES hub4-s HOLDS block-s
DOES hub4-s HOLDS conn-s1
PATTERN pin_to_axlehole_adapter
ADD axle9-s1 60485 lightgray
CONNECT axle9-s1.mid -> conn-s1.axlehole
DOES conn-s1 HOLDS axle9-s1
PATTERN axle_as_cross_bar
ADD axle7-s 44294 lightgray
ADD gear-5 4019 lightgray
CONNECT gear-5.axlehole -> axle7-s.end1
CONNECT axle7-s.mid -> block-s.axlehole
ADD bush-s1 3713 lightgray
CONNECT bush-s1.axlehole -> axle7-s.end2
DOES axle7-s CARRIES gear-5
DOES bush-s1 LOCKS axle7-s
PATTERN shaft_with_gear_and_bush
ADD lbeam-s3 32526 darkgray
CONNECT axle9-s1.end1 -> lbeam-s3.hole?
DOES axle9-s1 CARRIES lbeam-s3
PATTERN l_beam_side_plate
ADD bush-s2 3713 lightgray
CONNECT bush-s2.axlehole -> axle9-s1.end1
DOES bush-s2 LOCKS lbeam-s3
PATTERN bush_as_end_stop
ADD axle9-s2 60485 lightgray
ADD bush-s3 3713 lightgray
CONNECT bush-s3.axlehole -> axle9-s2.mid
CONNECT axle9-s2.end1 -> lbeam-s3.hole?
DOES lbeam-s3 HOLDS axle9-s2
DOES bush-s3 LOCKS axle9-s2
PATTERN two_bar_frame
ADD lbeam-s4 32526 darkgray
CONNECT axle9-s1.end2 -> lbeam-s4.hole?
CONNECT axle9-s2.end2 -> lbeam-s4.hole?
ADD crown-1 3650c lightgray
CONNECT crown-1.axlehole -> axle7-s.end2
DOES axle9-s1 CARRIES lbeam-s4
DOES axle9-s2 CARRIES lbeam-s4
DOES axle7-s CARRIES crown-1
PATTERN mirror_side
END
ATTACH seat
CONNECT pinlong-1.end2 -> lbeam-s3.hole?
CONNECT pinlong-2.end2 -> lbeam-s4.hole?
DOES pinlong-1 HOLDS seat
DOES pinlong-2 HOLDS seat
DOES turntable-O SUPPORTS seat
PATTERN upper_body_on_turntable


STEP 18
# No parts box; reading the arrows as 'push the blue pins in'.
CONNECT pinlong-1.end2 -> lbeam-s3.hole?
CONNECT pinlong-2.end2 -> lbeam-s4.hole?
DOES pinlong-1 LOCKS seat
DOES pinlong-2 LOCKS seat
PATTERN push_pins_home

STEP 19
# Model is turned around (turn symbol); which holes the shaft passes through is not visible.
ADD axle7-B 44294 lightgray
ADD axcon-1 59443 black
ADD axpin-1 43093 blue
ADD conn3-1 42003 black
CONNECT axle7-B.end1 -> axcon-1.axlehole
CONNECT axpin-1.axle -> axcon-1.axlehole
CONNECT axle7-B.mid -> seat.hole?
CONNECT conn3-1.axlehole -> axle7-B.end2
DOES axcon-1 HOLDS axpin-1
DOES axle7-B CARRIES conn3-1
PATTERN axle_to_pin_shaft

STEP 20
# Which blue pin (axpin-1 or pinlong) takes bent11-A is read from the arrow only.
ADD bent11-A 32009 black
CONNECT axpin-1.pin -> bent11-A.hole1
DOES axpin-1 HOLDS bent11-A
PATTERN bent_beam_side_frame

STEP 21
# Exact holes not visible.
ADD pin-21a 2780 black
ADD pin-21b 2780 black
ADD axle3-21 4519 lightgray
CONNECT pin-21a.end1 -> bent11-A.hole?
CONNECT pin-21b.end1 -> bent11-A.hole?
CONNECT axle3-21.end1 -> bent11-A.hole?
DOES bent11-A HOLDS pin-21a
DOES bent11-A HOLDS pin-21b
DOES bent11-A HOLDS axle3-21
PATTERN pins_as_mounting_posts

STEP 22
# conn3c-1 has no arrow. That gear-5 meshes gear-6 is read from the picture.
ADD conn3c-1 32184 lightgray
ADD gear-6 4019 lightgray
CONNECT conn3c-1.axlehole1 -> axle9-s1.end2
CONNECT conn3c-1.axlehole2 -> axle9-s2.end2
CONNECT gear-6.axlehole -> axle7-B.end2
MESH gear-5.teeth gear-6.teeth
RATIO gear-5 gear-6 16/16
DOES axle7-B CARRIES gear-6
DOES gear-5 DRIVES gear-6
DOES conn3c-1 HOLDS axle9-s1
PATTERN gear_pair_1to1

STEP 23
# What the lever moves is not confirmed yet.
ADD link9-1 64451 darkgray
ADD crank-1 33299a lightgray
CONNECT crank-1.pin -> link9-1.hole1
CONNECT crank-1.axlehole -> conn3c-1.pinhole
DOES crank-1 HOLDS link9-1
DOES link9-1 SPINS_ON crank-1
PATTERN crank_and_link_lever

STEP 24
# Which blue pin is used is read from the arrow only.
ADD bent11-B 32009 black
CONNECT pinlong-1.end2 -> bent11-B.hole1
DOES pinlong-1 HOLDS bent11-B
PATTERN mirror_side

STEP 25
# Exact holes not visible.
ADD pin-25a 2780 black
ADD pin-25b 2780 black
ADD axle3-25 4519 lightgray
CONNECT pin-25a.end1 -> bent11-B.hole?
CONNECT pin-25b.end1 -> bent11-B.hole?
CONNECT axle3-25.end1 -> bent11-B.hole?
DOES bent11-B HOLDS pin-25a
DOES bent11-B HOLDS pin-25b
DOES bent11-B HOLDS axle3-25
PATTERN mirror_side

STEP 26
# The worm meshing crown-1 is read from the picture.
ADD axle8s-1 55013 darkgray
ADD conn3-2 42003 black
ADD worm-1 4716 lightgray
ADD bush-26 3713 lightgray
CONNECT axle8s-1.mid -> conn3-2.axlehole
CONNECT worm-1.axlehole -> axle8s-1.mid
CONNECT bush-26.axlehole -> axle8s-1.end2
MESH worm-1.teeth crown-1.teeth
RATIO worm-1 crown-1 1/24
DOES axle8s-1 CARRIES worm-1
DOES worm-1 DRIVES crown-1
DOES bush-26 LOCKS axle8s-1
DOES conn3-2 HOLDS axle8s-1
PATTERN worm_drive

STEP 27
# Which axle gets the bush is read from the arrow only.
ADD bush-27 3713 lightgray
CONNECT bush-27.axlehole -> axle3-21.end2
DOES bush-27 LOCKS axle3-21
PATTERN bush_as_end_stop

STEP 28
# Dashed arrow read as 'push the worm shaft home'.
ADD bush-28 3713 lightgray
CONNECT bush-28.axlehole -> axle7-s.end2
DOES bush-28 LOCKS axle7-s
PATTERN bush_as_end_stop

STEP 29
# turn the model round, no parts

STEP 30
# Exact holes for the body pins not visible.
GROUP body
ADD pin-b1 6558 blue
ADD pin-b2 6558 blue
ADD beam9-b 40490 yellow
CONNECT pin-b1.end1 -> beam9-b.hole1
CONNECT pin-b2.end1 -> beam9-b.hole9
DOES beam9-b HOLDS pin-b1
DOES beam9-b HOLDS pin-b2
PATTERN pins_as_mounting_posts
# Which pin holds beam3-b is read from the arrow only.
ADD beam3-b 32523 darkgray
ADD pin-b3 2780 black
ADD pin-b4 2780 black
ADD pin-b5 2780 black
CONNECT pin-b3.end1 -> beam9-b.hole?
CONNECT pin-b4.end1 -> beam9-b.hole?
CONNECT pin-b5.end1 -> beam9-b.hole?
CONNECT pin-b3.end2 -> beam3-b.hole?
DOES pin-b3 HOLDS beam3-b
PATTERN pins_as_mounting_posts
ADD fairing-1 87080 yellow
CONNECT pin-b4.end2 -> fairing-1.hole?
CONNECT pin-b5.end2 -> fairing-1.hole?
DOES pin-b4 HOLDS fairing-1
DOES pin-b5 HOLDS fairing-1
PATTERN panel_on_pins
# What gear-7 meshes is not confirmed.
ADD bush-b 3713 lightgray
ADD axle4s-b 87083 darkgray
ADD gear-7 4019 lightgray
CONNECT gear-7.axlehole -> axle4s-b.end1
CONNECT axle4s-b.mid -> beam3-b.hole?
CONNECT bush-b.axlehole -> axle4s-b.end2
DOES axle4s-b CARRIES gear-7
DOES bush-b LOCKS axle4s-b
DOES axle4s-b SPINS_ON beam3-b
PATTERN shaft_with_gear_and_stop
# Which pins fairing-2 uses is not visible.
ADD fairing-2 87086 yellow
CONNECT pin-b1.end2 -> fairing-2.hole?
CONNECT pin-b3.end2 -> fairing-2.hole?
DOES pin-b1 HOLDS fairing-2
DOES pin-b3 HOLDS fairing-2
PATTERN mirror_side
END
ATTACH body
CONNECT pin-b2.end2 -> bent11-A.hole?
CONNECT pin-b1.end2 -> bent11-B.hole?
DOES bent11-A SUPPORTS body
DOES bent11-B SUPPORTS body
PATTERN side_build_attached

STEP 31
# turn the model, no parts

