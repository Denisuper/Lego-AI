ADD tread-20 3873 black
ADD tread-21 3873 black
ADD tread-22 3873 black
ADD tread-23 3873 black
ADD tread-24 3873 black
ADD tread-25 3873 black
ADD tread-26 3873 black
ADD tread-27 3873 black
ADD tread-28 3873 black
CONNECT tread-1.end2 -> tread-2.end1
CONNECT tread-2.end2 -> tread-3.end1
CONNECT tread-3.end2 -> tread-4.end1
CONNECT tread-4.end2 -> tread-5.end1
CONNECT tread-5.end2 -> tread-6.end1
CONNECT tread-6.end2 -> tread-7.end1
CONNECT tread-7.end2 -> tread-8.end1
CONNECT tread-8.end2 -> tread-9.end1
CONNECT tread-9.end2 -> tread-10.end1
CONNECT tread-10.end2 -> tread-11.end1
CONNECT tread-11.end2 -> tread-12.end1
CONNECT tread-12.end2 -> tread-13.end1
CONNECT tread-13.end2 -> tread-14.end1
CONNECT tread-14.end2 -> tread-15.end1
CONNECT tread-15.end2 -> tread-16.end1
CONNECT tread-16.end2 -> tread-17.end1
CONNECT tread-17.end2 -> tread-18.end1
CONNECT tread-18.end2 -> tread-19.end1
CONNECT tread-19.end2 -> tread-20.end1
CONNECT tread-20.end2 -> tread-21.end1
CONNECT tread-21.end2 -> tread-22.end1
CONNECT tread-22.end2 -> tread-23.end1
CONNECT tread-23.end2 -> tread-24.end1
CONNECT tread-24.end2 -> tread-25.end1
CONNECT tread-25.end2 -> tread-26.end1
CONNECT tread-26.end2 -> tread-27.end1
CONNECT tread-27.end2 -> tread-28.end1
CONNECT tread-28.end2 -> tread-1.end1
END
ATTACH track-left
MESH tread-?.teeth gear-1.teeth
MESH tread-?.teeth gear-2.teeth
GROUP track-right
ADD tread-29 3873 black
ADD tread-30 3873 black
ADD tread-31 3873 black
ADD tread-32 3873 black
ADD tread-33 3873 black
ADD tread-34 3873 black
ADD tread-35 3873 black
